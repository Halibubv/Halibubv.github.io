# Скопируйте в .env и впишите свои значения. Файл .env в Git не попадает.
APP_ENV=development
SESSION_SECURE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oborot
DB_USER=demoapps
DB_PASSWORD=
# На хостинге вместо DB_HOST... задаётся одна строка (DB_NAME всё равно главнее имени базы в ней):
# DATABASE_URL=mysql://user:password@host:port/defaultdb
# DB_SSL_CA=текст ca.pem или путь к файлу
# 1 — публичное демо: в админке можно менять только статусы записей, логины видны на странице входа
DEMO_MODE=0
# 1 — пересоздавать демо-данные при каждом запуске контейнера (start.sh)
RESET_DEMO=0
# 1 — сайт стоит за прокси (Render): адрес посетителя из X-Forwarded-For
TRUST_PROXY=0
# Необязательно: уведомления о новых записях в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
